<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Back_office</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
</head>

<body class="d-flex flex-column vh-100 ">
    <header>
        <nav class="navbar navbar-expand-sm mb-3 extra-navbar-styling">
            <div class="container-fluid">
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    @if (ViewData["EventId"] != null)
                        {
                            <ul class="navbar-nav flex-grow-1 gap-4">
                                <li class="nav-item">
                                    <a class="nav-link text-dark" href="javascript:history.back()" title="Go back">
                                        <i class="bi bi-arrow-left"></i> 
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Events" asp-route-eventId="@ViewData["EventId"]" asp-action="Edit">Event</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Session" asp-action="Index" asp-route-eventId="@ViewData["EventId"]">Sessions</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Speaker" asp-action="Index" asp-route-eventId="@ViewData["EventId"]">Speaker</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Room" asp-action="Index" asp-route-eventId="@ViewData["EventId"]">Rooms</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Tag" asp-action="Index" asp-route-eventId="@ViewData["EventId"]">Tags</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="DashBoard" asp-action="Index" asp-route-eventId="@ViewData["EventId"]">Dashboard</a>
                                </li>
                            </ul>
                        }
                        else if (User.IsInRole("Organiser") || User.IsInRole("Admin"))
                        {
                            <div class="d-flex flex-row">
                                <ul class="navbar-nav flex-grow-1 gap-4">
                                    <li class="nav-item">
                                        <a class="nav-link text-dark" asp-area="" asp-controller="Events" asp-action="Index">Events</a>
                                    </li>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li class="nav-item">
                                        <a class="nav-link text-dark" asp-area="" asp-controller="RoleManagement" asp-action="Organisers">Roles</a>
                                        </li>
                                    }
                                </ul>
                                <div class="mx-5 align-content-center">Select an event to edit the event data</div>
                            </div>
                        }
                        else
                        {
                            <div class="mx-5">You don't have the needed permission to access the pages</div>
                        }
                        <div id="userDropdown">
                        <button id="userDropdownToggle" aria-expanded="false">
                            <span>@(User.Identity?.Name ?? "Account")</span>
                            <i class="bi bi-chevron-down fs-5" id="dropDownToggleIcon"></i>
                            @{
                                var userPicture = User.FindFirst("picture")?.Value;
                            }
                            @if (!string.IsNullOrEmpty(userPicture))
                            {
                                <img src="@userPicture" alt="Profile picture" />
                            }
                            else
                            {
                                <img src="~/img/icons/person-circle.svg" alt="User" width="32" height="32" />
                            }
                        </button>
                        <ul id="userDropdownMenu" class="dropdown-menu">
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <li>
                                    <form asp-controller="Auth" asp-action="Logout" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item text-danger">Log out</button>
                                    </form>
                                </li>
                            }
                            else
                            {
                                <li><a class="dropdown-item" asp-controller="Auth" asp-action="Login">Login</a></li>
                                <li><a class="dropdown-item" asp-controller="Auth" asp-action="Register">Register</a></li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <main role="main" class="flex-fill d-flex flex-column height-main">
        <div id="toast" class="bg-@TempData["ToastType"] p-3 m-2 w-25 align-items-center align-self-end justify-content-between position-fixed bottom-0 end-0 z-3 @(TempData["ToastMessage"] != null && TempData["ToastType"] != null ? "d-flex" : "d-none")">
            <p class="m-0 text-white">@TempData["ToastMessage"]</p>
            <button type="button" class="btn-close btn-close-white" aria-label="Close" onclick="closeToast()"></button>
        </div>
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
