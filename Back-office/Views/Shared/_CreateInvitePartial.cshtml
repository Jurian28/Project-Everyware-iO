@using Back_office.Models.ViewModels
@model CreateInviteViewModel

<button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createInviteModal">
    Create invite
</button>

<div class="modal fade" id="createInviteModal" tabindex="-1" aria-labelledby="createInviteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="createInviteModalLabel">Create Invite</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <div id="createInviteSuccessMessageBox" class="alert alert-success d-none"></div>
                <div id="createInviteErrorMessageBox" class="alert alert-danger d-none" role="alert"></div>

                <form id="createInviteForm" method="post" asp-controller="EventInvite" asp-action="Create">
                    <div class="mb-3">
                        <label for="eventId" class="form-label">Select Event</label>

                        <select class="form-select" id="eventId" asp-for="EventId" required asp-items="ViewBag.Events">
                            <option value="">-- Choose an event --</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="expirationDate" class="form-label">Expiration Date</label>
                        <input type="date" class="form-control" id="expirationDate" asp-for="Expires" required
                                   min="@DateTime.UtcNow.Date.ToString("yyyy-MM-dd")"
                                   value="@DateTime.UtcNow.Date.ToString("yyyy-MM-dd")" />
                    </div>
                </form>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" form="createInviteForm" class="btn btn-primary">Save</button>
            </div>
        </div>
    </div>
</div>

<script defer src="~/js/createInvite.js" asp-append-version="true"></script>
