@model int
@{
    ViewData["Title"] = "Rooms";
}
@section Scripts {
    <script src="~/js/confirmModal.js"></script>
    <script src="~/js/rooms.js" defer data-event-id="@Model"></script>
}
<div class="d-flex flex-fill m-4 gap-3 mh-100 max-h-100 pb-1 overflow-hidden">
    <div style="flex: 2" class="bg-dark-subtle rounded-3 px-4 py-1 h-100 max-h-100">
        <div id="roomList" class="overflow-auto max-h-100">
            <div id="loadingMessage" class="text-center my-auto">Loading...</div>
            <div id="noRoomsMessage" class="text-center my-auto d-none">No rooms found</div>
        </div>
    </div>
    <div style="flex: 1" class="px-4">
        <form id="roomForm" class="d-flex flex-column h-100" onsubmit="submitRoom(event)" oninput="showEditButtons()">
            <div class="flex-grow-1">
                <input type="hidden" id="roomId" value="" />
                <div class="mb-3">
                    <label for="roomLabel" class="form-label">Room Label</label>
                    <input type="text" class="form-control" id="roomLabel" required />
                </div>
                <div class="mb-3">
                    <label for="capacity" class="form-label">Capacity</label>
                    <input type="number" class="form-control" id="capacity" min="1" required />
                </div>
                <div class="mb-3">
                    <label for="description" class="form-label">Description</label>
                    <textarea class="form-control" id="description"></textarea>
                </div>
            </div>
            <div>
                <div id="errorMessageBox" class="text-danger text-center"></div>
                <div id="successMessageBox" class="text-success text-break text-center"></div>
                <div class="d-flex justify-content-between">
                    <button id="deleteButton" type="button" class="btn btn-danger py-0 invisible" onclick="showModal('deleteRoomModal', deleteRoom, document.getElementById('roomLabel').value)">Delete</button>
                    <button type="button" class="js-room-edit-button btn btn-dark py-0 invisible" onclick="clearRoomForm()">Cancel</button>
                    <button type="submit" class="btn btn-success py-0">Save</button>
                </div>
            </div>
        </form>
    </div>
</div>

@await Html.PartialAsync("~/Views/Shared/Partials/_ConfirmModal.cshtml", null, new ViewDataDictionary(ViewData)
{
    { "ModalId", "deleteRoomModal" },
    { "Text1",   "Are you sure you want to delete the following room?" },
    { "Text2",   "This may delete connected sessions." }
})

<template id="roomRowTemplate">
    <div class="p-3 my-1 room-row" style="cursor:pointer">
        <span class="fw-bold" data-field="roomLabel"></span>
        <span data-field="capacity"></span>
        <span data-field="description"></span>
    </div>
</template>