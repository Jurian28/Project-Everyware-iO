@model SessionListDto
@{
    ViewData["Title"] = "Sessions";
}

<div class="container mt-4" style="font-family: sans-serif; color: #333;">
    
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div class="search-container" style="position: relative; width: 400px;">
            @* TODO Functionaliteit toevoegen *@
            <input type="text" class="form-control bg-light border-0" placeholder="Search a session"
                   style="padding-right: 40px; border-radius: 8px;">
            <i class="bi bi-search" style="position: absolute; right: 15px; top: 10px; color: #666;"></i>
        </div>
        <a asp-controller="Session" asp-action="AddSession" asp-route-eventId="@Model.EventId"
               class="btn btn-light shadow-sm px-4" style="border-radius: 8px; font-weight: 500;">
            New Session <span class="ms-2">+</span>
        </a>
    </div>

    <div class="session-list">
        @foreach (var session in Model.Sessions)
        {
            <div class="session-card d-flex justify-content-between mb-3 p-3"
                 style="background-color: #D9D9D9; border-radius: 4px;">
                
                <div class="left-content">
                    <h2 class="h4 mb-1" style="font-weight: 700;">@session.Title</h2>
    
                    <div class="text-dark mb-1">@(session.SpeakerName)</div>

                    <div class="d-flex gap-3" style="font-weight: 600;">
                        <span>@session.StartTime.ToString("HH:mm") - @session.EndTime.ToString("HH:mm")</span>
                        <span>@session.RoomName</span>
                        @if (session.Capacity != null)
                        {
                            <span>@session.Capacity spots</span>
                        }
                    </div>
                </div>

                <div class="right-content d-flex flex-column align-items-end justify-content-between">
                    <a asp-controller="Session" asp-action="EditSession" asp-route-eventId="@Model.EventId"
                           asp-route-sessionId="@session.SessionId"
                           class="btn btn-outline-dark btn-sm d-flex align-items-center gap-2 px-3"
                           style="background: #EAEAEA; border: 1px solid #000; border-radius: 8px;">
                        Edit <i class="bi bi-pencil-square"></i>
                    </a>
    
                    <div class="tags d-flex gap-2">
                        @if (session.Tags.Count() < 1)
                        {
                            <p>Geen tags</p>
                        }
                        else
                        {
                            @foreach (var tag in session.Tags)
                            {
                                <span class="badge rounded-pill"
                                      style="background-color: #B2EBF2; color: #006064; border: 1px solid #4DD0E1; padding: 8px 15px;">
                                    @tag.Title
                                </span>
                            }
                        }
                    </div>
                </div>

            </div>
        }
        @* TODO pagination *@
    </div>
</div>