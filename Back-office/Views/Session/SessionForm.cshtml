@model CUSessionDTO
@{
    bool isEdit = Model.session?.SessionId > 0;
    ViewData["Title"] = isEdit ? "Edit Session" : "Create Session";
}

@section Scripts {
    <script src="~/js/sessionForm.js" defer></script>
}

<form asp-controller="Session" asp-action="HandleSubmit" asp-route-eventId="@Context.GetRouteValue("eventId")"
      method="put" class="container-fluid p-4" style="background-color: #fff; font-family: sans-serif;">
    <input type="hidden" name="SessionId" value="@Model.session?.SessionId" />
    
    <div class="row">
        <div class="col-md-4 border-end pe-4">
            <div class="mb-3">
                <label class="fw-bold">Session Title</label>
                <input type="text" name="Title" class="form-control bg-light border-dark shadow-sm"
                       value="@Model.session?.Title" placeholder="Input text" required>
            </div>

            <div class="mb-3">
                <label class="fw-bold">Room</label>
                <select name="IdRoom" id="roomSelector" class="form-select bg-light border-dark shadow-sm" required>
                    <option value="">Select a room...</option>
                    @foreach (SessionRoomDTO room in Model.AvailableRooms)
                    {
                        <option value="@room.RoomId" data-capacity="@room.Capacity"
                                selected="@(room.RoomId == Model.session?.IdRoom)">
                            @room.RoomLabel (@room.Capacity plaatsen)
                        </option>
                    }
                </select>
            </div>

            <div class="row mb-3">
                <div class="col">
                    <label class="fw-bold">Start Time</label>
                    <input type="datetime-local" name="StartTime" class="form-control bg-light border-dark shadow-sm"
                           value="@Model.session?.StartTime.ToString("yyyy-MM-ddTHH:mm")"
                           min="@Model.EventStartTime.ToString("yyyy-MM-ddTHH:mm")"
                           max="@Model.EventEndTime.ToString("yyyy-MM-ddTHH:mm")" required>
                </div>

                <div class="col">
                    <label class="fw-bold">End Time</label>
                    <input type="datetime-local" name="EndTime" class="form-control bg-light border-dark shadow-sm"
                           value="@Model.session?.EndTime.ToString("yyyy-MM-ddTHH:mm")"
                           min="@Model.EventStartTime.ToString("yyyy-MM-ddTHH:mm")"
                           max="@Model.EventEndTime.ToString("yyyy-MM-ddTHH:mm")" required>
                </div>
            </div>
            <div class="mb-3">
                <label class="fw-bold d-block">Plenary session</label>
                <div class="form-check form-switch p-0 d-flex align-items-center" style="min-height: 38px;">
                    <input type="checkbox" id="plenaryToggle" name="Plenary" class="form-check-input ms-0" role="switch"
                           style="transform: scale(1.5); cursor: pointer;" @(Model.session?.Plenary == true ? "checked" :
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  "") value="true">
                </div>
            </div>

            <div class="mb-3 w-50">
                <label class="fw-bold">Capacity</label>
                <input type="number" id="capacityInput" name="Capacity" min="1"
                       class="form-control bg-light border-dark shadow-sm" value="@Model.session?.Capacity"
                       placeholder="Number">
            </div>
        </div>

        <div class="col-md-4 border-end px-4">
            <label class="fw-bold">Select Tag</label>
            <select id="tagSelector" class="form-select bg-light border-dark shadow-sm mb-3">
                <option value="">Select a tag...</option>
                @foreach (SessionTagDTO tag in Model.AvailableTags)
                {
                    <option value="@tag.Title">@tag.Title</option>
                }
            </select>
            <div id="tagContainer" class="p-3"
                 style="background-color: #8E8E8E; min-height: 250px; border-radius: 12px; border: 2px solid #000;">
                @if (Model.session?.Tags != null)
                {
                    @foreach (SessionTagDTO tag in Model.session.Tags)
                    {
                        <div class="tag-item d-flex justify-content-between align-items-center mb-2 p-2 rounded border border-dark"
                             style="background-color: #E2F37C; font-weight: 600;">
                            <span>@tag.Title</span>
                            <input type="hidden" name="selectedTagTitles" value="@tag.Title" />
                            <i class="bi bi-x-circle-fill cursor-pointer"></i>
                        </div>
                    }
                }
            </div>
        </div>

        <div class="col-md-4 ps-4">
            <label class="fw-bold">Select Speaker</label>
            <select name="SpeakerId" class="form-select bg-light border-dark shadow-sm">
                <option value="">Select a speaker...</option>
                @foreach (SessionSpeakerDTO speaker in Model.AvailableSpeakers)
                {
                    <option value="@speaker.SpeakerId" selected="@(speaker.SpeakerId == Model.session?.SpeakerId)">
                        @speaker.Name
                    </option>
                }
            </select>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-3 mt-5">
        @if (isEdit)
        {
            <a href="javascript:void(0)"
                   onclick="if(confirm('Weet je zeker dat je deze sessie wilt verwijderen?')) { document.getElementById('delete-form').submit(); }"
                   class="btn btn-danger px-5" style="border-radius: 20px; background-color: #EF4444; border:none;">
                Delete
            </a>
        }
        <a href="javascript:history.back()" class="btn btn-secondary px-5"
           style="border-radius: 20px; background-color: #9CA3AF; border:none;">Cancel</a>
        <button type="submit" class="btn btn-success px-5"
                style="border-radius: 20px; background-color: #10B981; border:none;">save</button>
    </div>
</form>
<form id="delete-form" asp-controller="Session" asp-action="DeleteSession"
      asp-route-eventId="@Context.GetRouteValue("eventId")" asp-route-sessionId="@Model.session?.SessionId" method="post"
      style="display:none;">
</form>