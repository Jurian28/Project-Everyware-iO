@model CUSessionDTO
@{
    var isEdit = Model.session?.SessionId > 0;
    ViewData["Title"] = isEdit ? "Edit Session" : "Create Session";
}

<form asp-action="Save" method="post" class="container-fluid p-4"
      style="background-color: #fff; font-family: sans-serif;">
    <div class="row">
        <div class="col-md-4 border-end">
            <div class="mb-3">
                <label class="fw-bold">Session Title</label>
                <input type="text" name="Title" class="form-control bg-light border-dark shadow-sm"
                       value="@Model.session?.Title" placeholder="Input text">
            </div>

            <div class="mb-3">
                <label class="fw-bold">Room</label>
                <select name="IdRoom" class="form-select bg-light border-dark shadow-sm">
                    <option value="">Select a room...</option>
                    @foreach (var room in Model.AvailableRooms)
                    {
                        <option value="@room.RoomId" selected="@(room.RoomId == Model.session?.IdRoom)">
                            @room.RoomLabel (@room.Capacity seats)
                        </option>
                    }
                </select>
            </div>

            <div class="row mb-3">
                <div class="col">
                    <div class="row mb-3">
                        <div class="col">
                            <label class="fw-bold">Start Time</label>
                            <input type="datetime-local" name="StartTime"
                                   class="form-control bg-light border-dark shadow-sm"
                                   value="@Model.session?.StartTime.ToString("yyyy-MM-ddTHH:mm")">
                        </div>
                        <div class="col">
                            <label class="fw-bold">End Time</label>
                            <input type="datetime-local" name="EndTime"
                                   class="form-control bg-light border-dark shadow-sm"
                                   value="@Model.session?.EndTime.ToString("yyyy-MM-ddTHH:mm")">
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="fw-bold">Description</label>
                        <textarea name="Description" class="form-control bg-light border-dark shadow-sm" rows="4"
                                  placeholder="Input text"></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="fw-bold d-block">Plenary session</label>
                        <div class="form-check form-switch px-0 ms-4">
                            <input type="checkbox" name="Plenary" class="form-check-input" role="switch"
                                   style="transform: scale(1.5);" @(Model.session?.Plenary == true ? "checked" : "")
                                   value="true">
                        </div>
                    </div>

                    <div class="mb-3 w-50">
                        <label class="fw-bold">Capacity</label>
                        <input type="number" name="Capacity" class="form-control bg-light border-dark shadow-sm"
                               value="@Model.session?.Capacity" placeholder="Number">
                    </div>
                </div>

                <div class="col-md-4 border-end">
                    <label class="fw-bold">Select Tag</label>
                    <div class="input-group mb-3">
                        <select id="tagSelector" class="form-select bg-light border-dark shadow-sm">
                            <option value="">Select a tag...</option>
                            @foreach (var tag in Model.AvailableTags)
                            {
                                <option value="@tag.EventId">@tag.Title</option>
                            }
                        </select>
                    </div>

                    <div id="tagContainer" class="p-3"
                         style="background-color: #8E8E8E; min-height: 250px; border-radius: 12px; border: 2px solid #000;">
                        @if (Model.session?.Tags != null)
                        {
                            @foreach (var tag in Model.session.Tags)
                            {
                                <div class="tag-item d-flex justify-content-between align-items-center mb-2 p-2 rounded border border-dark"
                                     style="background-color: #E2F37C; font-weight: 600;">
                                    <span>@tag.Title</span>
                                    <input type="hidden" name="SelectedTagIds" value="@tag.EventId" />
                                    <i class="bi bi-x-circle-fill cursor-pointer" onclick="this.parentElement.remove()"></i>
                                </div>
                            }
                        }
                    </div>
                </div>

                <div class="col-md-4">
                    <label class="fw-bold">Select Speaker</label>
                    <select name="SpeakerId" class="form-select bg-light border-dark shadow-sm">
                        <option value="">Select a speaker...</option>
                        @foreach (var speaker in Model.AvailableSpeakers)
                        {
                            <option value="@speaker.SpeakerId" selected="@(speaker.SpeakerId == Model.session?.SpeakerId)">
                                @speaker.Name
                            </option>
                        }
                    </select>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-3 mt-5 pe-4">
                <a href="javascript:history.back()" class="btn btn-secondary px-5"
                   style="border-radius: 20px; background-color: #9CA3AF; border:none;">Cancel</a>
                <button type="submit" class="btn btn-success px-5"
                        style="border-radius: 20px; background-color: #10B981; border:none;">save</button>
            </div>
        </form>