@using Back_office.Models.ViewModels
@model LoginViewModel

<div class="align-items-center d-flex flex-column px-3">
    <h1 class="w-fit-content mb-3">Login</h1>

    <form asp-action="Login" method="post" class="d-flex flex-column gap-3 col-12 col-sm-10 col-md-8 col-lg-5 col-xl-4">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="d-flex flex-column">
            <label asp-for="Email">Email</label>
            <input type="email" asp-for="Email" class="form-control" />
            <span class="text-danger" asp-validation-for="Email"></span>
        </div>

        <div class="d-flex flex-column">
            <label asp-for="Password">Password</label>
            <input type="password" asp-for="Password" class="form-control" />
            <span class="text-danger" asp-validation-for="Password"></span>
        </div>

        <div class="justify-content-center">
            <button type="submit" class="btn btn-primary me-3">Log in</button>

            <span class="text-center">Don't have an account? <a asp-action="Register">Sign up</a>.</span>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}