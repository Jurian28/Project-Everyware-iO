@model List<Event>

<div class="container">
    <h1>Events</h1>

    <div>
        @if (Model != null && Model.Any())
        {
            <p>Eventslist:</p>
            @foreach (Event eventItem in Model)
            {
                <p>@eventItem.Title</p>
            }
        }
        else
        {
            <p>There are no events or an error occured.</p>
        }
    </div>
    
    <div>
        <a class="btn btn-primary" asp-controller="Home">Back to Home</a>
    </div>

    <div>
        <a class="btn btn-secondary" asp-controller="Events" asp-action="Create">Add Event</a>
    </div>
</div>
