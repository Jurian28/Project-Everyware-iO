@using SharedClassLibrary.DTOs.Events
@model List<EventDTO>

<script src="~/js/events.js" defer></script>

<div id="event-toast" class="bg-@TempData["ToastType"] p-3 align-items-center justify-content-between fixed-bottom @(TempData["ToastMessage"] != null && TempData["ToastType"] != null ? "d-flex" : "d-none")">
    <p class="m-0 text-white">@TempData["ToastMessage"]</p>
    <button type="button" class="btn-close btn-close-white" aria-label="Close" onclick="closeToast()"></button>
</div>

<div class="container">
    <h1 class="mt-3">Events</h1>

    <div>
        <div class="d-flex justify-content-between align-items-center py-4">
            <div class="d-flex w-50 gap-4">
                <div class="event-search-input-wrapper">
                    <form asp-action="Index" method="GET" >
                        <input type="text" name="search" value="@ViewData["CurrentSearch"]" placeholder="Search an event" class="form-control bg-light event-search-input" />
                        <button type="submit" class="event-search-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640"><path d="M480 272C480 317.9 465.1 360.3 440 394.7L566.6 521.4C579.1 533.9 579.1 554.2 566.6 566.7C554.1 579.2 533.8 579.2 521.3 566.7L394.7 440C360.3 465.1 317.9 480 272 480C157.1 480 64 386.9 64 272C64 157.1 157.1 64 272 64C386.9 64 480 157.1 480 272zM272 416C351.5 416 416 351.5 416 272C416 192.5 351.5 128 272 128C192.5 128 128 192.5 128 272C128 351.5 192.5 416 272 416z" /></svg>
                        </button>
                    </form>
                </div>
                <a class="btn btn-secondary" asp-controller="Events" asp-action="Index">Empty Search</a>
            </div>
            <a class="btn btn-primary" asp-controller="Events" asp-action="Create">Add Event</a>
        </div>

        @* List of Events *@
        <div>
            @if (Model != null && Model.Any())
            {
                <div class="d-flex justify-content-between flex-wrap gap-5">
                    @foreach (EventDTO eventItem in Model)
                    {
                        <partial name="Partials/EventCard" model="eventItem" />
                    }
                </div>
            }
            else
            {
                <p>There are no events (with this filter).</p>
            }

            @{
                int totalPages = (int) ViewData["TotalPages"];
                int currentPage = (int) ViewData["CurrentPage"];
            }

            @* Pagination *@
            <div class="d-flex justify-content-center mt-5">
                <ul class="pagination gap-3">
                    <a class="page-link event-page-link d-inline-flex align-items-center gap-1" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-search="@ViewData["CurrentSearch"]">
                        <img src="~/img/icons/arrow-left.svg" alt="Previous" />
                        Previous
                    </a>
                    <ul class="pagination">
                        @for (int i = 1; i <= totalPages; i++)
                        {
                            <li class="page-item @(i == currentPage ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-search="@ViewData["CurrentSearch"]">@i</a>
                            </li>
                        }
                    </ul>
                    <a class="page-link event-page-link d-inline-flex align-items-center gap-1" asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-search="@ViewData["CurrentSearch"]">
                        Next
                        <img src="~/img/icons/arrow-right.svg" alt="Next" />
                    </a>
                </ul>
            </div>
        </div>
    </div>
</div>
