@model bool

@section Scripts {
    <script src="~/js/organiserManagement.js"></script>
    <script src="~/js/confirmModal.js"></script>
}

<div class="d-flex flex-fill m-4 gap-3 mh-100 max-h-100 pb-1 overflow-hidden">
    <div style="flex: 2" class="bg-dark-subtle rounded-3 px-4 py-1 h-100 d-flex flex-column overflow-hidden">
        <h2 class="d-flex justify-content-center">Requests</h2>
        <div class="d-flex w-100 justify-content-end">
            <button class="btn btn-danger" onclick="showModal('denyAllRequestsModal', denyAllRequests)">Deny all</button>
        </div>
        <div id="requestList" class="d-flex overflow-auto flex-grow-1 min-h-0 gap-2 flex-column my-2">
            <div id="loadingRequests" class="text-center my-auto">Loading...</div>
            <div id="noRequestsMessage" class="text-center my-auto d-none">No requests found</div>
        </div>
    </div>
    <div style="flex: 2" class="bg-dark-subtle rounded-3 px-4 py-1 h-100 d-flex flex-column overflow-hidden">
        <h2 class="d-flex justify-content-center">Organisers</h2>
        <div id="organiserList" class="d-flex overflow-auto flex-grow-1 min-h-0 gap-2 flex-column my-2">
            <div id="loadingOrganisers" class="text-center my-auto">Loading...</div>
            <div id="noOrganisersMessage" class="text-center my-auto d-none">No organisers found</div>
        </div>
    </div>
</div>

@await Html.PartialAsync("~/Views/Shared/Partials/_ConfirmModal.cshtml", null, new ViewDataDictionary(ViewData)
{
    { "ModalId", "revokeOrganiserModal" },
    { "Text1",   "Are you sure you want to revoke the following organiser?" },
    { "Text2",   "" }
})

@await Html.PartialAsync("~/Views/Shared/Partials/_ConfirmModal.cshtml", null, new ViewDataDictionary(ViewData)
{
    { "ModalId", "denyAllRequestsModal" },
    { "Text1",   "Are you sure you want to deny all requests?" },
    { "Text2",   "" }
})

<template id="organiserRowTemplate">
    <div class="d-flex align-items-center justify-content-between p-3 border-bottom bg-white organiser-row">
        <div>
            <span data-field="email" class="text-muted ms-2 small"></span>
        </div>
        <button data-action="remove" class="btn btn-sm btn-outline-danger">Remove</button>
    </div>
</template>

<template id="requestRowTemplate">
    <div class="d-flex align-items-center justify-content-between p-3 border-bottom bg-white request-row">
        <div>
            <span data-field="email" class="text-muted ms-2 small"></span>
        </div>
        <div class="d-flex gap-2">
            <button data-action="approve" class="btn btn-sm btn-success">Approve</button>
            <button data-action="deny" class="btn btn-sm btn-outline-danger">Deny</button>
        </div>
    </div>
</template>