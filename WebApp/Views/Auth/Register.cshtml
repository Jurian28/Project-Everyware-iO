@using WebApp.Models.ViewModels
@model RegisterViewModel

<h1>Sign up</h1>

<form asp-action="Register" method="post" class="d-flex flex-column gap-3">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="d-flex flex-column">
        <label asp-for="Email">Email</label>
        <input type="email" asp-for="Email" />
        <span class="text-danger" asp-validation-for="Email"></span>
    </div>

    <div class="d-flex flex-column">
        <label asp-for="Password">Password</label>
        <input type="password" asp-for="Password" />
        <span class="text-danger" asp-validation-for="Password"></span>
    </div>

    <div class="d-flex flex-column">
        <label asp-for="ConfirmPassword">Confirm password</label>
        <input type="password" asp-for="ConfirmPassword" />
        <span class="text-danger" asp-validation-for="ConfirmPassword"></span>
    </div>

    <div class="d-flex flex-row gap-3">
        <input type="checkbox" asp-for="RememberMe" />
        <label asp-for="RememberMe">Remember me</label>
    </div>

    <div class="justify-content-center">
        <button type="submit">Sign up</button>

        <span>Already have an account? <a asp-action="Login">Sign in</a>.</span>
    </div>
</form>