FROM node:22-alpine

WORKDIR /app

# Zet omgevingsvariabele om vragen te voorkomen
ENV CI=true

# Kopieer package bestanden vanuit de root context
COPY MobileApp/package*.json ./

# Installeer ALLE dependencies (ook devDependencies voor webpack)
RUN npm install --legacy-peer-deps --ignore-scripts

# Manually patch MaskedView after install
RUN echo "export { default } from '../MaskedView';" > \
    node_modules/@react-navigation/elements/lib/module/Header/MaskedView.js

# Kopieer de rest
COPY MobileApp/ .
COPY SharedClassLibrary/ ../SharedClassLibrary/

# Expose poort
EXPOSE 8081

# Gebruik 'npx' direct of een npm script
CMD ["npm", "run", "web"]